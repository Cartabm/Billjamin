@tool
extends VBoxContainer

const ResourceScanner = preload("res://addons/unused_resource_finder/resource_scanner.gd")
const OVERSIZED_DIMENSION_PX: int = 2048

var editor_interface: EditorInterface
var _unused: Array = []
var _oversized: Array = []
# Parallel to the list rows: "unused" or "oversized", so activating/exporting
# a row knows which array (and which path key) it came from.
var _row_kinds: Array = []

@onready var _toolbar: HBoxContainer = $Toolbar
@onready var _status_label: Label = $StatusLabel
@onready var _list: ItemList = $ResultList

func _ready() -> void:
	_toolbar.get_node("ScanButton").pressed.connect(_on_scan_pressed)
	_toolbar.get_node("ExportButton").pressed.connect(_on_export_pressed)
	_toolbar.get_node("ExportButton").disabled = true
	_list.item_activated.connect(_on_item_activated)
	_status_label.text = "Click Scan to audit unused and oversized assets."

func _on_scan_pressed() -> void:
	_status_label.text = "Scanning..."
	_list.clear()
	_row_kinds.clear()
	var scanner := ResourceScanner.new()
	var result: Dictionary = scanner.scan("res://")
	_unused = result["unused"]
	_oversized = result["oversized"]
	for entry in _unused:
		var kb: float = entry["size"] / 1024.0
		_list.add_item("[Unused]    %s  (%.1f KB)" % [entry["path"], kb])
		_row_kinds.append("unused")
	for entry in _oversized:
		var kb: float = entry["size"] / 1024.0
		_list.add_item("[Oversized] %s  (%dx%d, %.1f KB)" % [entry["path"], entry["width"], entry["height"], kb])
		_row_kinds.append("oversized")

	var total := _unused.size() + _oversized.size()
	if total == 0:
		_status_label.text = "No unused or oversized assets found. Nice and tidy."
	else:
		_status_label.text = "%d unused, %d oversized (>%dpx). Review before deleting or resizing." % [_unused.size(), _oversized.size(), 2048]
	_toolbar.get_node("ExportButton").disabled = total == 0

func _entry_for_row(index: int) -> Dictionary:
	if index < _unused.size():
		return _unused[index]
	return _oversized[index - _unused.size()]

func _on_item_activated(index: int) -> void:
	if index < 0 or index >= _row_kinds.size():
		return
	var path: String = _entry_for_row(index)["path"]
	var abs_path := ProjectSettings.globalize_path(path)
	OS.shell_show_in_file_manager(abs_path)

func _on_export_pressed() -> void:
	var out_path := "res://asset_audit.md"
	var file := FileAccess.open(out_path, FileAccess.WRITE)
	if file == null:
		push_error("Unused Resource Finder: could not write %s" % out_path)
		return
	file.store_line("# Asset audit")
	file.store_line("")
	file.store_line("Generated by Unused Resource Finder. Review each entry before deleting or resizing anything.")
	file.store_line("")
	file.store_line("## Unused (%d)" % _unused.size())
	file.store_line("")
	for entry in _unused:
		var kb: float = entry["size"] / 1024.0
		file.store_line("- `%s` (%.1f KB) — no res:// path or uid:// reference found" % [entry["path"], kb])
	file.store_line("")
	file.store_line("## Oversized (%d)" % _oversized.size())
	file.store_line("")
	for entry in _oversized:
		var kb: float = entry["size"] / 1024.0
		file.store_line("- `%s` (%dx%d, %.1f KB)" % [entry["path"], entry["width"], entry["height"], kb])
	file.close()
	_status_label.text = "Exported to asset_audit.md"
	if editor_interface:
		var fs := editor_interface.get_resource_filesystem()
		if fs:
			fs.scan()
